# ==============================================================================
# Pheonix — Unified Environment Configuration (.env.example)
# Copy this file to .env and configure the values for your deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System & Server Runtime
# ------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
ENVIRONMENT=local

# ------------------------------------------------------------------------------
# 2. AI Model Providers & Gateway Routing
# ------------------------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=sk-placeholder
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=sk-ant-placeholder
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google Gemini
GEMINI_API_KEY=AIzaSyPlaceholder
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Local Model Serving (Ollama & Llama.cpp)
OLLAMA_BASE_URL=http://localhost:11434
LLAMA_CPP_BASE_URL=http://localhost:8080

# AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SESSION_TOKEN=

# Model Aggregators & Routers (OpenRouter, Requesty, Eden AI)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
REQUESTY_API_KEY=
REQUESTY_BASE_URL=https://router.requesty.ai/v1
EDEN_AI_API_KEY=
EDEN_AI_BASE_URL=https://api.edenai.run/v2

# Default Model & Gateway Endpoint
DEFAULT_MODEL=llama3.2
MODEL_GATEWAY_URL=http://localhost:3000
GATEWAY_URL=http://localhost:4000
LIBRETRANSLATE_URL=http://localhost:5000
TEST_GATEWAY_SECRET=dev-test-secret-gateway-key

# ------------------------------------------------------------------------------
# 3. Agent & Memory Subsystem
# ------------------------------------------------------------------------------
MEMORY_SERVICE_URL=http://localhost:8001
MEMORY_VECTOR_BACKEND=qdrant
MEMORY_EMBEDDING_BACKEND=ollama
MEMORY_FACT_BACKEND=sqlite
MEMORY_WORKING_BACKEND=inmemory

# Qdrant Vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_LOCATION=http://localhost:6333
COLLECTION_NAME=pheonix_memory
EMBEDDING_DIM=1536

# Chroma & SQLite Paths
CHROMA_PATH=./data/chroma
SQLITE_PATH=./data/memory.db
SQLITE_DB_PATH=./data/agent.db
WAL_DIR=./data/wal

# Redis & Postgres (Optional / Production Backends)
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/pheonix
REDIS_URL=redis://localhost:6379/0

# Memory Tuning & Retention
WORKING_WINDOW_TURNS=10
TOP_K_SEMANTIC_MATCHES=5
DECAY_HALF_LIFE_DAYS=30
MAX_CONTEXT_TOKENS=8192
SESSION_TTL_SECONDS=86400

# ------------------------------------------------------------------------------
# 4. Guardrails & Safety Policy
# ------------------------------------------------------------------------------
GUARDRAIL_PROVIDER=pheonix_native
GUARDRAILS_SEVERITY_THRESHOLD=warn
GUARDRAILS_AUDIT_LOG_PATH=./data/guardrails_audit.log

# ------------------------------------------------------------------------------
# 5. Sandboxes & Code Execution
# ------------------------------------------------------------------------------
SANDBOX_PROVIDER=local_docker
SANDBOX_TIMEOUT_SECONDS=30
E2B_API_KEY=

# ------------------------------------------------------------------------------
# 6. Global & Web Search
# ------------------------------------------------------------------------------
SEARCH_PROVIDER=meilisearch
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=masterKeyPheonix2026
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=xyzPheonixTypesenseKey

# Firecrawl & Crawl4AI
FIRECRAWL_API_KEY=
CRAWL4AI_BASE_URL=http://localhost:11235

# ------------------------------------------------------------------------------
# 7. Voice & Realtime (LiveKit, STT, TTS)
# ------------------------------------------------------------------------------
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
WHISPER_ENDPOINT=http://localhost:9000
TTS_PROVIDER=mock

# ------------------------------------------------------------------------------
# 8. Notifications & Observability
# ------------------------------------------------------------------------------
NOVU_API_KEY=
NOVU_BACKEND_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3100

# ------------------------------------------------------------------------------
# 9. Feature Flags
# ------------------------------------------------------------------------------
FEATURE_MCP=true
FEATURE_A2A=true
FEATURE_CONSOLE_UI=true
FEATURE_GEOIP=false
FEATURE_TOOL_SEARCH=true
FEATURE_SECRETS_SYNC=true
FEATURE_PREPAID_CREDITS=false
FEATURE_VOICE_LEASES=true

# ------------------------------------------------------------------------------
# 10. Security, Vault & Cryptographic Keys
# ------------------------------------------------------------------------------
PHEONIX_SECRET_KEY=dev-pheonix-secret-key-32-chars-long!
VAULT_PASSPHRASE=master-vault-passphrase-default
VAULT_STORAGE_PATH=./data/vault.enc

