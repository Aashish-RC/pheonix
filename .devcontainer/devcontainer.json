{
  "name": "Pheonix Development Environment",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableMoby": false
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts",
      "pnpmVersion": "latest"
    }
  },
  "forwardPorts": [
    4000,
    6333,
    7700,
    8025,
    11434,
    3001,
    3002,
    3005
  ],
  "portsAttributes": {
    "4000": {
      "label": "Model Gateway",
      "onAutoForward": "notify"
    },
    "6333": {
      "label": "Qdrant Vector DB",
      "onAutoForward": "silent"
    },
    "7700": {
      "label": "Meilisearch",
      "onAutoForward": "silent"
    },
    "8025": {
      "label": "Mailpit Email Web UI",
      "onAutoForward": "notify"
    },
    "11434": {
      "label": "Ollama Local LLM",
      "onAutoForward": "silent"
    },
    "3001": {
      "label": "Novu API",
      "onAutoForward": "notify"
    },
    "3002": {
      "label": "Novu WebSocket",
      "onAutoForward": "silent"
    },
    "3005": {
      "label": "Novu Dashboard",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bash -c 'if [ ! -f .env ]; then cp .env.example .env; fi && pip install --no-cache-dir -e \".[all]\" && pnpm --dir model-gateway install'",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker",
        "charliermarsh.ruff"
      ]
    }
  }
}