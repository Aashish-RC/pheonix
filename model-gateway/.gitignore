# ==============================================================================
# Model Gateway - Git Ignore Rules
# ==============================================================================

# Clones (Mandatory exclusion - Clones stay local until 100% verified, never pushed)
clones/
clones/**

# Node dependencies
node_modules/
**/node_modules/

# Build and distribution artifacts
dist/
**/dist/
.turbo/
**/build/

# Logs and debug files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and secrets
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db
